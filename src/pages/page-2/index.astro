---
import Galaxy from '../../component/Galaxy.tsx';
import "../../styles/global.css";
import Page2 from '../../svelte/page-2.svelte';
---
<html>
  <head>
    <meta charset="UTF-8">
  </head>
  <body>
    <div style="position: fixed; width: 100%; height: 100vh;">
      <!-- client:only="react" skips SSR, runs fully in browser -->
        <Galaxy client:only="react"  />
      <!-- Your page content on top -->
      <div style="position: relative; z-index: 10;">
        <h1></h1>
      </div>
    </div>
    <Page2 />
  </body>
</html>
